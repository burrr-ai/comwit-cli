{
  "contractId": "comwit-infra-migration-expected-v5",
  "credentials": {
    "mcp": "COMWIT_PAT",
    "runtime": "COMWIT_CLOUD_TOKEN",
    "deploy": "COMWIT_DEPLOY_TOKEN"
  },
  "localUserAuthentication": {
    "method": "device_flow",
    "startCommand": "comwit login",
    "verificationCommand": "comwit projects list",
    "deviceStartPath": "/v1/auth/device",
    "devicePollPath": "/v1/auth/device/token",
    "serverTokenIssue": false,
    "serverTokenRevoke": false
  },
  "resourceBindings": {
    "mode": "tracked_source",
    "sourceFile": "src/server/resource-config.ts",
    "exportName": "comwitResources",
    "databaseField": "databaseUrl",
    "storageFields": {
      "id": "id",
      "endpoint": "endpoint",
      "bucket": "bucket",
      "publicBaseUrl": "publicBaseUrl"
    },
    "stagingEnvCleanup": {
      "after": "verified_source_update",
      "database": ["DATABASE_URL"],
      "storage": [
        "COMWIT_STORAGE_ID",
        "COMWIT_STORAGE_ENDPOINT",
        "COMWIT_STORAGE_BUCKET",
        "COMWIT_STORAGE_PUBLIC_BASE_URL"
      ]
    }
  },
  "ports": {
    "projectToken": {
      "status": "pending_runtime_scope_and_idempotency_contract",
      "purposes": ["deploy", "runtime"],
      "issueInput": ["ccProjectId", "purpose"],
      "issueOutput": ["tokenId", "tokenPrefix", "token", "scopes"],
      "revokeInput": ["ccProjectId", "tokenId"],
      "requiredRuntimeCapabilities": [
        "database_data",
        "storage_read",
        "storage_write"
      ],
      "runtimeScopeNames": null
    },
    "cgRouting": {
      "status": "pending_comwit_base_url",
      "legacyBaseUrl": "https://cg.mvpstar.net",
      "comwitBaseUrl": null,
      "routingKey": "persisted_session_backend",
      "apiSurface": "same_as_legacy",
      "sessionCreatePath": "/session",
      "requestFields": ["memberId", "projectName"],
      "responseEnvelope": "session",
      "serverDefaultTemplate": "comwit",
      "authContract": null,
      "requiredPathFamilies": [
        "session",
        "deployment",
        "env",
        "usage",
        "message",
        "stream",
        "command"
      ],
      "forbiddenRequestFields": [
        "template",
        "hostingProvider",
        "templateRepo",
        "templateRef"
      ]
    },
    "cgConfiguration": {
      "status": "pending_comwit_base_url",
      "path": "/session/{sessionId}/env",
      "apiSurface": "same_as_legacy",
      "environmentKeys": ["COMWIT_PROJECT", "COMWIT_APP"],
      "secretKeys": ["COMWIT_DEPLOY_TOKEN", "COMWIT_CLOUD_TOKEN"],
      "requiredGuarantees": [
        "idempotent",
        "masked",
        "rotatable",
        "deletable",
        "retryable"
      ]
    },
    "databaseAuthentication": {
      "status": "pending_external_contract",
      "runtimeCredential": "COMWIT_CLOUD_TOKEN",
      "legacyCredential": "DATABASE_AUTH_TOKEN",
      "scopeNames": null
    },
    "storageCors": {
      "status": "pending_external_contract",
      "path": "/v1/projects/{projectId}/storages/{storageId}/cors",
      "methods": ["GET", "PUT", "DELETE"],
      "rule": {
        "allowed_origins": ["*"],
        "allowed_methods": ["PUT"],
        "allowed_headers": ["Content-Type"],
        "expose_headers": [],
        "max_age_seconds": 3600
      }
    }
  },
  "stableExternalContracts": {
    "appFields": ["app_id", "name", "default_url", "default_domain"],
    "storagePresignPath": "/v1/projects/{projectId}/storages/{storageId}/presigned-urls"
  },
  "pendingErrorCodes": [
    "comwit_cloud_project_token_scopes",
    "comwit_cloud_project_token_revoke",
    "cg_comwit_base_url",
    "database_comwit_token_auth",
    "storage_cors_contract",
    "storage_comwit_token_auth",
    "storage_presign_contract",
    "prism_member_pat_revoke"
  ]
}
